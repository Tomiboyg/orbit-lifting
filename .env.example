# Supabase project credentials (anon/public values only).
# These are safe to expose in the frontend bundle; security is enforced by RLS.
# NEVER put the service-role key here or in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base path when hosting on GitHub Pages under /<repo-name>/ (leave "/" for a custom domain).
# In CI this is set automatically from the repository name.
# BASE_PATH=/orbit-lifting/
